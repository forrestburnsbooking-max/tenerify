# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# remotion reels (local marketing assets)
/public/clips

# reels media archive — raw footage stays local (keep README/.gitkeep only)
/public/reels/**/*.mp4
/public/reels/**/*.mov
/public/reels/**/*.m4a
/public/reels/**/*.mp3
/public/reels/**/*.wav
/public/reels/**/*.png
/public/reels/**/*.jpg
/public/reels/**/*.jpeg

# generated episode voiceover + personal voice sample (never commit)
/public/episodes/audio
/public/episodes/voice-sample.*

# private outreach / PR materials (target lists, pitches, press kit) — never publish
/outreach
